[Unit]
Description=Loom Enterprise Runtime Service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/loom serve
User=loom
Group=loom
Restart=always
RestartSec=3
Environment="LOOM_HOST=0.0.0.0:11434"
Environment="LOOM_MODELS=/var/lib/loom/models"
LimitNOFILE=65536
MemoryAccounting=true
CPUAccounting=true

[Install]
WantedBy=multi-user.target
